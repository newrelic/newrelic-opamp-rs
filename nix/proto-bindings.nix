# The Rust bindings of the OpAMP spec are generated by proto/build.rs and committed. This check
# regenerates them from the spec input and fails if the committed file differs.
{ inputs, ... }:
{
  perSystem =
    {
      pkgs,
      craneLib,
      commonArgs,
      ...
    }:
    {
      checks.proto-bindings = craneLib.mkCargoDerivation (
        commonArgs
        // {
          pname = "proto-bindings";
          cargoArtifacts = null;
          doInstallCargoArtifacts = false;
          nativeBuildInputs = [ pkgs.protobuf ];
          buildPhaseCargoCommand = ''
            cp proto/src/proto.rs "$TMPDIR/committed.rs"
            mkdir -p proto/opamp-spec
            cp -r --no-preserve=mode ${inputs.opamp-spec}/. proto/opamp-spec/
            REBUILD_PROTO=true cargo build --locked -p proto
            cargo fmt -p proto
            diff -u "$TMPDIR/committed.rs" proto/src/proto.rs || {
              echo "proto/src/proto.rs is out of date: run 'make -C proto' and commit the result" >&2
              exit 1
            }
          '';
          installPhaseCommand = "mkdir -p $out";
        }
      );
    };
}
